```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Local data and generated output
# data/*
# !data/.gitkeep
output/*
!output/.gitkeep

# Local databases and backups
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
```
backups/
